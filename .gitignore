*.safetensors
*.bin
*.pt
*.ckpt
models/
adapters/
activations/

# Results and generated artifacts
results/*
!results/.gitkeep

# Editor / OS
.DS_Store
.vscode/
.idea/

# Demo runtime state (logs, pids, tunnel binaries, uploads, job DBs)
demo/**/run/
demo/**/runtime/
*.sqlite-wal
*.sqlite-shm
*.log
*.pid

