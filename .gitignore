# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.venv-inspect/

# Environment / secrets
.env
.env.*
*.key
*.pem

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
